{
 "duration": 113.241,
 "segments": [
  {
   "start": 0.0,
   "end": 2.2,
   "text": "Bayangin seekor lebah keluar dari sarangnya. Bayangin seekor lebah keluar dari sarangnya.",
   "words": []
  },
  {
   "start": 2.36,
   "end": 6.72,
   "text": "Dia terbang melewati pohon, belok ke kebun, mampir dari bunga ke bunga.",
   "words": []
  },
  {
   "start": 7.17,
   "end": 8.51,
   "text": "Terus pas mau pulang,",
   "words": []
  },
  {
   "start": 8.68,
   "end": 9.83,
   "text": "Dia gak bisa buka maps.",
   "words": []
  },
  {
   "start": 10.08,
   "end": 10.7,
   "text": "La",
   "words": []
  },
  {
   "start": 10.95,
   "end": 11.82,
   "text": "Rumahnya di mana?",
   "words": []
  },
  {
   "start": 12.22,
   "end": 14.47,
   "text": "Gimana lebah menemukan jalan pulang ke sarangnya?",
   "words": []
  },
  {
   "start": 14.81,
   "end": 16.09,
   "text": "Coba kita ikuti jejaknya.",
   "words": []
  },
  {
   "start": 16.45,
   "end": 21.11,
   "text": "Ternyata perjalanan pulang itu sudah disiapkan sejak sebelum dia sibuk mencari makan.",
   "words": []
  },
  {
   "start": 21.45,
   "end": 24.9,
   "text": "Lebah madu pekerja melakukan penerbangan orientasi di sekitar sarang.",
   "words": []
  },
  {
   "start": 25.22,
   "end": 26.57,
   "text": "Ia melihat pintu masuknya.",
   "words": []
  },
  {
   "start": 26.78,
   "end": 29.95,
   "text": "lalu menjelajah lebih jauh dan mengenali pemandangan di sekitarnya.",
   "words": []
  },
  {
   "start": 30.35,
   "end": 31.29,
   "text": "Pohon di sini.",
   "words": []
  },
  {
   "start": 31.49,
   "end": 32.57,
   "text": "tepi kebun di sana,",
   "words": []
  },
  {
   "start": 32.78,
   "end": 34.37,
   "text": "Bentuk garis langit di kejauhan.",
   "words": []
  },
  {
   "start": 34.71,
   "end": 36.73,
   "text": "Jadi saat berangkat, dia gak cuma lewat.",
   "words": []
  },
  {
   "start": 37.02,
   "end": 37.99,
   "text": "Dia juga belajar.",
   "words": []
  },
  {
   "start": 38.33,
   "end": 40.03,
   "text": "Lalu bagaimana dia menjaga arah?",
   "words": []
  },
  {
   "start": 40.32,
   "end": 42.4,
   "text": "Salah satu petunjuknya ada di atas.",
   "words": []
  },
  {
   "start": 42.63,
   "end": 43.26,
   "text": "Matahari",
   "words": []
  },
  {
   "start": 43.59,
   "end": 46.08,
   "text": "Lebah bisa memakai posisinya sebagai kompas. Lebah bisa memakai posisinya sebagai kompas. Lebah bisa memakai posisinya sebagai kompas. Lebah bisa memakai posisinya sebagai kompas. Lebah bisa memakai posisinya sebagai kompas. Lebah bisa memakai posisinya sebagai kompas. Leb",
   "words": []
  },
  {
   "start": 46.36,
   "end": 48.66,
   "text": "Tapi matahari terus bergeser sepanjang hari.",
   "words": []
  },
  {
   "start": 48.96,
   "end": 49.6,
   "text": "Karena itu,",
   "words": []
  },
  {
   "start": 49.78,
   "end": 52.7,
   "text": "Perkiraan arahnya juga berkaitan dengan jam biologis lebah.",
   "words": []
  },
  {
   "start": 52.99,
   "end": 54.13,
   "text": "Kompasnya ikut awal.",
   "words": []
  },
  {
   "start": 54.29,
   "end": 54.47,
   "text": "satu",
   "words": []
  },
  {
   "start": 54.72,
   "end": 57.32,
   "text": "Kita yang sering lupa naruh kunci, agak tersinggung.",
   "words": []
  },
  {
   "start": 57.63,
   "end": 58.48,
   "text": "terus jaraknya,",
   "words": []
  },
  {
   "start": 58.79,
   "end": 59.85,
   "text": "Saat lebah terbang,",
   "words": []
  },
  {
   "start": 60.03,
   "end": 61.93,
   "text": "Pemandangan bergerak melewati matanya.",
   "words": []
  },
  {
   "start": 62.24,
   "end": 65.93,
   "text": "Gerakan itu membantu memberi gambaran seberapa jauh ia sudah terbang.",
   "words": []
  },
  {
   "start": 66.23,
   "end": 69.28,
   "text": "Tapi ini bukan angka kilometer yang muncul rapi di kepalanya.",
   "words": []
  },
  {
   "start": 69.52,
   "end": 72.63,
   "text": "Pemandangan yang berbeda bisa memberi petunjuk yang berbeda pula.",
   "words": []
  },
  {
   "start": 72.94,
   "end": 75.83,
   "text": "Saat pulang, petunjuk-petunjuk tadi dipakai bersama.",
   "words": []
  },
  {
   "start": 76.15,
   "end": 77.02,
   "text": "Arah dari langit.",
   "words": []
  },
  {
   "start": 77.24,
   "end": 78.43,
   "text": "perkiraan perjalanan,",
   "words": []
  },
  {
   "start": 78.64,
   "end": 79.48,
   "text": "Lalu pohon. Lalu pohon.",
   "words": []
  },
  {
   "start": 79.68,
   "end": 82.27,
   "text": "kebun, dan bentuk tempat yang pernah ia kenali.",
   "words": []
  },
  {
   "start": 82.59,
   "end": 84.26,
   "text": "Kalau satu petunjuk kurang membantu,",
   "words": []
  },
  {
   "start": 84.48,
   "end": 85.95,
   "text": "yang lain bisa ikut berperan.",
   "words": []
  },
  {
   "start": 86.19,
   "end": 90.18,
   "text": "Peneliti bahkan pernah memindahkan lebah ke lokasi lain dan melacak penerbangannya.",
   "words": []
  },
  {
   "start": 90.49,
   "end": 95.21,
   "text": "Lebah yang sudah mengenal bentang alam itu bisa memakai ingatannya untuk mencari arah pulang.",
   "words": []
  },
  {
   "start": 95.52,
   "end": 98.12,
   "text": "Jadi dia gak sedang mengikuti garis ajaib di udara.",
   "words": []
  },
  {
   "start": 98.37,
   "end": 101.39,
   "text": "Di balik penerbangan kecil yang kelihatannya asal belok itu,",
   "words": []
  },
  {
   "start": 101.59,
   "end": 102.85,
   "text": "Ada proses tersembunyi.",
   "words": []
  },
  {
   "start": 103.15,
   "end": 104.36,
   "text": "Lebah membaca langit.",
   "words": []
  },
  {
   "start": 104.57,
   "end": 105.85,
   "text": "Melihat pemandangan bergerak,",
   "words": []
  },
  {
   "start": 106.07,
   "end": 108.32,
   "text": "dan mengenali tempat yang pernah dilewatinya.",
   "words": []
  },
  {
   "start": 108.68,
   "end": 111.11,
   "text": "Kalau lo dilepas di kebun yang asing tanpa HP,",
   "words": []
  },
  {
   "start": 111.35,
   "end": 112.9,
   "text": "Yakin bisa pulang secepat lebah?",
   "words": []
  }
 ]
